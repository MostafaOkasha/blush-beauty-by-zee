---
// Treatment page, one template for every service (manuscript §7).
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Compare from '../../components/Compare.astro';
import closingArt from '../../assets/chat_gpt_images/H16-footer-lips.png';
import { services, serviceBySlug, steps, type ServicePage } from '../../data/services';
import { SQUARE_BOOKING_URL, policy } from '../../data/site';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}

const { s } = Astro.props as { s: ServicePage };
const isLip = s.category === 'Lip Artistry';
const process = steps[isLip ? 'lip' : 'skin'];
const related = s.related.map((slug) => serviceBySlug[slug]).filter(Boolean);
---

<Base title={s.title} description={s.description}>
  <section class="svc-hero" aria-labelledby="svc-title">
    <div class="container svc-hero__grid">
      <div class="svc-hero__copy">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">/</span><a href={isLip ? '/#lips' : '/#skin'}>{s.category}</a><span
            aria-hidden="true">/</span
          ><span aria-current="page">{s.name}</span>
        </nav>
        <p class="eyebrow">{s.eyebrow}</p>
        <h1 id="svc-title" class="display svc-hero__title">{s.h1} <em>{s.h1em}</em></h1>
        <p class="section-lead">{s.lead}</p>
        <dl class="svc-facts">
          <div><dt>Price</dt><dd>{s.price}</dd></div>
          <div><dt>Appointment</dt><dd>{s.duration}</dd></div>
          <div><dt>Deposit</dt><dd>$50</dd></div>
        </dl>
        <div class="cta-row">
          <a class="btn btn--plum" href={SQUARE_BOOKING_URL} target="_blank" rel="noopener">Book {s.name} <span aria-hidden="true">→</span></a>
          {s.pair ? <a class="btn btn--outline" href="#results">See results</a> : <a class="btn btn--outline" href="#faq">Questions</a>}
        </div>
      </div>
      <div class="svc-hero__media">
        <Image src={s.hero} alt="" widths={[600, 1100]} sizes="(min-width: 900px) 45vw, 100vw" loading="eager" />
      </div>
    </div>
  </section>

  <section class="svc-about" aria-label={`About ${s.name}`}>
    <div class="container svc-about__grid">
      {
        s.sections.map((sec) => (
          <article class="svc-block" data-reveal>
            <h2 class="display display--sm">{sec.heading}</h2>
            <p>{sec.body}</p>
          </article>
        ))
      }
      {
        s.questions && (
          <article class="svc-block" data-reveal>
            <h2 class="display display--sm">What to ask before proceeding.</h2>
            <ul class="checks" role="list">
              {s.questions.map((q) => (
                <li>{q}</li>
              ))}
            </ul>
          </article>
        )
      }
    </div>
  </section>

  <section class="svc-steps" aria-labelledby="steps-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">The process</p>
        <h2 id="steps-title" class="display">What to expect, <em>step by step.</em></h2>
      </div>
      <ol class="steps" role="list">
        {
          process.map((st, i) => (
            <li class="step" data-reveal>
              <span class="step__n">{String(i + 1).padStart(2, '0')}</span>
              <h3>{st.title}</h3>
              <p>{st.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    s.pair && (
      <section id="results" class="results" aria-labelledby="svc-results-title">
        <div class="container svc-results">
          <div class="results__intro" data-reveal>
            <p class="eyebrow eyebrow--pink">Documented result</p>
            <h2 id="svc-results-title" class="display display--light">
              What healed work <em>can look like.</em>
            </h2>
            <p>
              {s.pair.key} · {s.pair.sessions} · {s.pair.stage}. Drag the handle to compare. Fresh and healed cosmetic
              tattoos look different, and every result is individual.
            </p>
            <a class="btn btn--pink" href="/results">
              More results <span aria-hidden="true">→</span>
            </a>
          </div>
          <Compare pairs={[s.pair]} caption={false} />
        </div>
      </section>
    )
  }

  <section class="svc-pricing" aria-labelledby="pricing-title">
    <div class="container">
      <div class="section-head section-head--split" data-reveal>
        <div>
          <p class="eyebrow">Pricing</p>
          <h2 id="pricing-title" class="display">Clear prices. <em>Clear next steps.</em></h2>
        </div>
        <p class="section-lead">Consultation: {policy.consultation} Patch test: {policy.patchTest}</p>
      </div>
      <ul class="price-cards" role="list">
        {
          (s.pricing ?? []).map((p) => (
            <li class="price-card" data-reveal>
              <span class="price-card__label">{p.label}</span>
              <span class="price-card__price">{p.price}</span>
              <span class="price-card__note">{p.note}</span>
            </li>
          ))
        }
      </ul>
      <p class="fine-print">Prices in CAD, from the current service list. Confirm details during booking.</p>
    </div>
  </section>

  <section id="faq" class="faq" aria-labelledby="faq-title">
    <div class="container faq__grid">
      <div data-reveal>
        <p class="eyebrow">Good to know</p>
        <h2 id="faq-title" class="display">{s.name} <em>questions.</em></h2>
        <p class="section-lead">Anything else? Zheen is happy to talk it through at a consultation.</p>
      </div>
      <div class="faq__list">
        {
          s.faqs.map((f) => (
            <details class="faq__item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="svc-related" aria-labelledby="related-title">
    <div class="container">
      <h2 id="related-title" class="display display--sm" data-reveal>You might also <em>explore.</em></h2>
      <ul class="related-row" role="list">
        {
          related.map((r) => (
            <li data-reveal>
              <a class="related-card" href={`/services/${r.slug}`}>
                <Image class="related-card__img" src={r.hero} alt="" widths={[480, 800]} sizes="(min-width: 760px) 40vw, 90vw" />
                <span class="related-card__body">
                  <span class="related-card__name">{r.name}</span>
                  <span class="related-card__price">{r.price}</span>
                </span>
                <span class="arrow-circle arrow-circle--light" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="closing" aria-labelledby="closing-title">
    <Image class="closing__art" src={closingArt} alt="" widths={[836, 1672]} sizes="100vw" />
    <div class="container" data-reveal>
      <p class="eyebrow eyebrow--pink">Based in Orléans, Ottawa</p>
      <h2 id="closing-title" class="display display--light display--xl">Ready when <em>you are.</em></h2>
      <p>Book {s.name} directly, or start with a $25 consultation if you'd like to talk it through first.</p>
      <div class="cta-row">
        <a class="btn btn--pink" href={SQUARE_BOOKING_URL} target="_blank" rel="noopener">Book {s.name} <span aria-hidden="true">→</span></a>
        <a class="btn btn--outline-light" href={SQUARE_BOOKING_URL} target="_blank" rel="noopener">Book a Consultation</a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { initHomeMotion } from '../../scripts/home-motion';
  initHomeMotion();
</script>
