---
// Typefaces matched to the design mockups: Bodoni Moda (display), Montserrat (text), Ms Madi (script).
import '@fontsource-variable/bodoni-moda/opsz.css';
import '@fontsource-variable/bodoni-moda/opsz-italic.css';
import '@fontsource-variable/montserrat';
import '@fontsource/ms-madi';
import '../styles/global.css';
import { SQUARE_BOOKING_URL, INSTAGRAM_URL, policy } from '../data/site';

interface Props {
  title: string;
  description: string;
  overHero?: boolean;
}
const { title, description, overHero = false } = Astro.props;
const nav = [
  ['Lip Services', '/services#lip'],
  ['Skin Services', '/services#skin'],
  ['Results', '/results'],
  ['About', '/about'],
  ['FAQs', '/faq'],
];
// Highlight the menu item for the page you're on (service pages count as their category).
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const lipSlugs = ['lip-blush', 'lip-neutralization', 'lip-ombre'];
const isCurrent = (href: string) => {
  if (href.startsWith('/services#')) {
    if (!path.startsWith('/services/')) return false;
    const slug = path.split('/')[2];
    return href.endsWith('#lip') ? lipSlugs.includes(slug) : !lipSlugs.includes(slug);
  }
  return path === href;
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1d0c12" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class:list={['site-header', { 'is-over-hero': overHero }]} data-header>
      <a class="wordmark" href="/" aria-label="Blush Beauty by Zee — home">
        <span class="wordmark__main">Blush Beauty</span>
        <span class="wordmark__sub">by Zee</span>
      </a>
      <nav class="site-nav" id="site-nav" aria-label="Main" data-nav>
        {nav.map(([label, href]) => <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>)}
        <a class="site-nav__book" href={SQUARE_BOOKING_URL} target="_blank" rel="noopener">Book an Appointment</a>
        <p class="site-nav__contact">
          <a href={INSTAGRAM_URL} target="_blank" rel="noopener">@blushbeautybyzee</a>
          <a href={`mailto:${policy.email}`}>{policy.email}</a>
        </p>
      </nav>
      <a class="btn btn--pink btn--sm site-header__book" href={SQUARE_BOOKING_URL} target="_blank" rel="noopener">
        Book Now <span aria-hidden="true">→</span>
      </a>
      <button class="menu-btn" type="button" aria-controls="site-nav" aria-expanded="false" data-menu-btn>
        <span class="sr-only">Open menu</span>
        <span class="menu-btn__bars" aria-hidden="true"></span>
      </button>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container site-footer__inner">
        <div class="site-footer__brand">
          <p class="wordmark wordmark--footer">
            <span class="wordmark__main">Blush Beauty</span>
            <span class="wordmark__sub">by Zee</span>
          </p>
          <p>
            Lip artistry and specialized skin camouflage and revision services in Orléans, Ottawa. Discover our
            work, explore your options, and book your next appointment.
          </p>
        </div>
        <div>
          <h2>Explore</h2>
          <ul>
            <li><a href="/services">All Services</a></li>
            <li><a href="/services/lip-blush">Lip Blush</a></li>
            <li><a href="/services/lip-neutralization">Lip Neutralization</a></li>
            <li><a href="/services/lip-ombre">Lip Ombré</a></li>
            <li><a href="/services/stretch-mark-revision">Stretch Mark Revision</a></li>
            <li><a href="/services/scar-camouflage">Scar Camouflage</a></li>
            <li><a href="/services/vitiligo-camouflage">Vitiligo Camouflage</a></li>
            <li><a href="/services/radiation-marker-camouflage">Radiation Marker Camouflage</a></li>
            <li><a href="/results">Real Results</a></li>
            <li><a href="/about">About</a></li>
          </ul>
        </div>
        <div>
          <h2>Get in Touch</h2>
          <ul>
            <li><a href={SQUARE_BOOKING_URL} target="_blank" rel="noopener">Book Online</a></li>
            <li><a href={INSTAGRAM_URL} target="_blank" rel="noopener">Instagram @blushbeautybyzee</a></li>
            <li><a href={`mailto:${policy.email}`}>{policy.email}</a></li>
            <li>Orléans, Ottawa, Ontario</li>
            <li>{policy.hours}</li>
          </ul>
        </div>
      </div>
      <div class="container site-footer__legal">
        <p>Treatments, suitability and results vary by individual. Consultation may be recommended.</p>
        <p>© {new Date().getFullYear()} Blush Beauty by Zee. All rights reserved.</p>
      </div>
    </footer>
    <a class="book-bar" href={SQUARE_BOOKING_URL} target="_blank" rel="noopener" data-book-bar>
      Book now <span aria-hidden="true">→</span>
    </a>
    <script>
      // Mobile menu: plain toggle, closes on link tap and Escape.
      const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
      const nav = document.querySelector<HTMLElement>('[data-nav]');
      const label = btn?.querySelector('.sr-only');
      const setOpen = (open: boolean) => {
        btn?.setAttribute('aria-expanded', String(open));
        document.documentElement.classList.toggle('menu-open', open);
        if (label) label.textContent = open ? 'Close menu' : 'Open menu';
      };
      btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
      nav?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) setOpen(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setOpen(false);
      });

      // Phones and tablets: a floating "Book now" once the page has scrolled past its
      // opening screen, tucked away again over the closing call to action and footer.
      const bar = document.querySelector<HTMLElement>('[data-book-bar]');
      if (bar) {
        let past = false;
        let atEnd = false;
        const update = () => bar.classList.toggle('is-shown', past && !atEnd);
        const onScroll = () => {
          const next = window.scrollY > window.innerHeight * 0.6;
          if (next !== past) {
            past = next;
            update();
          }
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
        const ends = document.querySelectorAll('.closing, .site-footer');
        const seen = new Set<Element>();
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) e.isIntersecting ? seen.add(e.target) : seen.delete(e.target);
          atEnd = seen.size > 0;
          update();
        });
        ends.forEach((el) => io.observe(el));
      }

      // Arriving from another page with #section: the browser jumps before fonts and
      // images settle, so land again once the page has finished loading.
      const settleOnHash = () => {
        const id = decodeURIComponent(location.hash.slice(1));
        const el = id && document.getElementById(id);
        if (el) el.scrollIntoView({ behavior: 'instant', block: 'start' });
      };
      if (location.hash) {
        if (document.readyState === 'complete') settleOnHash();
        else window.addEventListener('load', () => requestAnimationFrame(settleOnHash), { once: true });
        document.fonts?.ready.then(() => requestAnimationFrame(settleOnHash));
      }
    </script>
  </body>
</html>
